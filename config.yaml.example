# 复制为 config.yaml（与 skillrelay 二进制同目录），填入你的 LLM key
# 任何 OpenAI 兼容端点均可；base_url 含 /anthropic 时走 Anthropic messages 协议
# 优先级：环境变量（SKILLRELAY_LLM_API_KEY / LLM_API_KEY，兼容 GLM_API_KEY / ZHIPUAI_API_KEY）
#        > web 设置页保存（存 DB meta） > 本文件
# 注意：model 未配置时 LLM 功能（去重判定/合并建议/关系归纳）降级不可用，其余功能不受影响
llm_api_key: ""
llm_base_url: "https://api.openai.com/v1"
llm_model: ""
